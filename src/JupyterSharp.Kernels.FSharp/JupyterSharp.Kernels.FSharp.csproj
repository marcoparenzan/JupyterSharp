<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>JupyterSharp.Kernels.FSharp</PackageId>
    <Version>0.3.1-net11-preview.6</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>JupyterSharp kernel that runs F# cells via FSharp.Compiler.Service's interactive (FSI) session, with session state shared across cells for free (a real REPL session, unlike PySharp's PyEngine).</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JupyterSharp.Kernels.Abstractions\JupyterSharp.Kernels.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.401" />
  </ItemGroup>
</Project>