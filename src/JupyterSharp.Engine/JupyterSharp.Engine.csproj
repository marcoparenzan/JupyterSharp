<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>JupyterSharp.Engine</PackageId>
    <Version>0.3.1-net11-preview.6</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>Reusable JupyterSharp engine: nbformat (.ipynb) read/write, kernel plugin discovery (every kernel is a plugin; the engine references none), and NotebookSession — the kernel-dispatch/variable-injection core JupyterSharp.Host, the jupytersharp CLI, and any embedding application all build on.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JupyterSharp.Kernels.Abstractions\JupyterSharp.Kernels.Abstractions.csproj" />
  </ItemGroup>
</Project>