{
  "name": "jupytersharp-notebook",
  "displayName": "JupyterSharp Notebook",
  "description": "C#, F#, PowerShell, Power Fx, PySharp, Ontly and Ralf .ipynb notebooks in VS Code, backed by a JupyterSharp.Host process.",
  "version": "0.2.3",
  "publisher": "marcoparenzan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Notebooks", "Programming Languages", "Machine Learning"],
  "activationEvents": [
    "onNotebook:jupytersharp-notebook"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "notebooks": [
      {
        "type": "jupytersharp-notebook",
        "displayName": "JupyterSharp Notebook",
        "priority": "option",
        "selector": [{ "filenamePattern": "*.ipynb" }]
      }
    ],
    "notebookRenderer": [
      {
        "id": "jupytersharp-html-renderer",
        "displayName": "JupyterSharp HTML output",
        "entrypoint": "./out/renderer/index.js",
        "mimeTypes": ["text/html"]
      }
    ],
    "languages": [
      { "id": "csharp", "extensions": [".cs"] },
      { "id": "fsharp", "extensions": [".fs"] },
      { "id": "powerfx", "aliases": ["Power Fx"] },
      { "id": "pysharp", "aliases": ["PySharp"] },
      { "id": "ontly", "aliases": ["Ontly"] },
      { "id": "ralf", "aliases": ["Ralf"] }
    ],
    "commands": [
      {
        "command": "jupytersharp.newNotebook",
        "title": "JupyterSharp: New Notebook",
        "category": "JupyterSharp"
      },
      {
        "command": "jupytersharp.restartHost",
        "title": "JupyterSharp: Restart Kernel Host",
        "category": "JupyterSharp"
      }
    ],
    "configuration": {
      "title": "JupyterSharp",
      "properties": {
        "jupytersharp.hostDll": {
          "type": "string",
          "default": "",
          "description": "Path to JupyterSharp.Host.dll. Empty uses the copy bundled with the extension (host/JupyterSharp.Host.dll)."
        },
        "jupytersharp.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "The 'dotnet' executable used to run JupyterSharp.Host."
        },
        "jupytersharp.kernelPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Directories JupyterSharp.Host scans for kernel plugins (pysharp/ontly/ralf), forwarded to it as JUPYTERSHARP_KERNEL_PATHS. Each is one plugin's own 'dotnet publish' output. Defaults to the PySharp plugin in the Science suite; override to use your own plugin builds."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json && tsc -p ./tsconfig.renderer.json",
    "watch": "tsc -w -p ./tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
